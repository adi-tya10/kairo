APP_NAME="KAIRO Engine API"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-this-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kairo

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kairo_password

REDIS_URL=redis://localhost:6379/0

GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
JIRA_WEBHOOK_SECRET=your_jira_webhook_secret_here
LINEAR_WEBHOOK_SECRET=your_linear_webhook_secret_here
GITLAB_WEBHOOK_SECRET=your_gitlab_webhook_secret_here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# LLM & Embeddings Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL_NAME=gemini-1.5-pro
LLM_TEMPERATURE=0.1

# CORS & Frontend
CORS_ORIGINS=["http://localhost:3000","http://localhost:1420","tauri://localhost"]
NEXT_PUBLIC_API_URL=http://localhost:8000