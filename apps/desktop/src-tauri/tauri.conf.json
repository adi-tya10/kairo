{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kairo-desktop",
  "version": "0.1.0",
  "identifier": "dev.kairo.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "kairo-hud",
        "title": "KAIRO HUD",
        "width": 200,
        "height": 54,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
